{
    "name": "ibrahimjml/laravel-modules",
    "description": "Laravel modules generator",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ibrahimjml\\LaravelModules\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ibrahimjml\\LaravelModules\\ModuleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
